    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "web-ext": "^8.9.0",
    "webextension-polyfill-ts": "^0.26.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
